SKILL_NAME = "learning_loop"
SKILL_DESCRIPTION = "Boucle d'apprentissage autonome : fetch web, enrichit génome, fait évoluer, garde le meilleur"
SKILL_VERSION = "1.0.0"
EXECUTION_PROFILE = "web"

import json
import time
from pathlib import Path
from datetime import datetime
from logger import log_info, log_error


class LearningLoop:
    def __init__(self):
        self.state_file = Path(".milodo/learning_state.json")
        self.state = self._load_state()

    def _load_state(self):
        if self.state_file.exists():
            return json.loads(self.state_file.read_text(encoding="utf-8"))
        return {"cycles": 0, "last_run": None, "best_score": 0, "history": []}

    def _save_state(self):
        self.state_file.parent.mkdir(parents=True, exist_ok=True)
        self.state_file.write_text(json.dumps(self.state, indent=2, ensure_ascii=False), encoding="utf-8")

    def _write_heartbeat(self):
        try:
            heartbeat = {
                "last_beat": datetime.now().isoformat(),
                "cycle": self.state["cycles"] + 1,
                "best_score": self.state["best_score"]
            }
            heartbeat_file = Path(".milodo/heartbeat.json")
            heartbeat_file.parent.mkdir(parents=True, exist_ok=True)
            tmp_file = heartbeat_file.with_suffix(".tmp")
            tmp_file.write_text(json.dumps(heartbeat, indent=2, ensure_ascii=False), encoding="utf-8")
            tmp_file.replace(heartbeat_file)
        except Exception as e:
            log_error(f"Heartbeat write error: {e}")

    def run_once(self):
        log_info("Learning Loop : démarrage cycle")

        self._write_heartbeat()

        try:
            from skills.web_learner import WebLearner
            wl = WebLearner()
            result = wl.inject_into_genome()
            log_info(f"Web fetch : {result.get('success')}")
        except Exception as e:
            log_error(f"Web fetch error : {e}")
        self._write_heartbeat()

        best_this_cycle = 0
        try:
            from coding_agent import genome_aware_evolve
            evo = genome_aware_evolve("landing", f"auto_cycle_{self.state['cycles']}", generations=2)
            scores = [g.get("score", 0) for g in evo.get("evolution", [])]
            best_this_cycle = max(scores) if scores else 0
            log_info(f"Evolution : best = {best_this_cycle}")
            self._write_heartbeat()
        except Exception as e:
            log_error(f"Evolution error : {e}")

        improved = best_this_cycle > self.state["best_score"]
        if improved:
            self.state["best_score"] = best_this_cycle
            log_info(f"Nouveau meilleur score : {best_this_cycle}")

        self.state["cycles"] += 1
        self.state["last_run"] = datetime.now().isoformat()
        self.state["history"].append({
            "cycle": self.state["cycles"],
            "score": best_this_cycle,
            "improved": improved,
            "date": self.state["last_run"]
        })
        self._save_state()
        self._write_heartbeat()

        return {
            "success": True,
            "cycle": self.state["cycles"],
            "score": best_this_cycle,
            "improved": improved,
            "best_overall": self.state["best_score"]
        }

    def run_scheduled(self, interval_hours=1):
        log_info(f"Learning Loop scheduler démarré ({interval_hours}h)")
        try:
            while True:
                try:
                    self.run_once()
                except Exception as e:
                    log_error(f"Scheduler error : {e}")
                time.sleep(interval_hours * 3600)
        except KeyboardInterrupt:
            log_info("Scheduler arrêt demandé, cleanup...")
            self._save_state()
            log_info("Scheduler arrêté proprement")

    def status(self):
        return {"success": True, "state": self.state}


def run(action="start", **kwargs):
    loop = LearningLoop()
    if action == "start":
        return loop.run_once()
    elif action == "schedule":
        interval_hours = kwargs.get("interval", 1)
        return loop.run_scheduled(interval_hours)
    elif action == "status":
        return loop.status()
    else:
        return {"success": False, "error": f"Action inconnue : {action}"}
