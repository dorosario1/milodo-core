{
  "_comment": "Configuration MILODO CORE V2 - Modifie ce fichier selon ton environnement",

  "ai": {
    "provider": "ollama",
    "_provider_options": "ollama | openai | fallback",

    "ollama": {
      "url": "http://localhost:11434",
      "model": "llama3.2"
    },

    "openai": {
      "api_key": "",
      "model": "gpt-4o-mini"
    }
  },

  "server": {
    "host": "127.0.0.1",
    "port": 8520
  },

  "scanner": {
    "roots": [
      "Desktop",
      "Documents",
      "projects"
    ]
  },

  "memory": {
    "dir": ".milodo",
    "max_entries": 1000
  }
}

